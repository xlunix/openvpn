# Конфигурация OpenSSL для использования bee2evp engine
# Этот файл настраивает OpenSSL для использования белорусских криптографических алгоритмов
# через bee2evp engine вместо стандартных алгоритмов OpenSSL

# Указывает OpenSSL использовать кастомную конфигурацию вместо системной
# Это позволяет переопределить стандартные настройки для использования bee2evp
openssl_conf = openssl_init

# Секция инициализации OpenSSL
# Здесь определяются модули, которые будут загружены при старте OpenSSL
[openssl_init]
engines = engine_section

# Секция определения engines (криптографических движков)
# Engine - это модуль, который предоставляет альтернативные реализации алгоритмов
[engine_section]
bee2evp = bee2evp_section

# Секция настройки bee2evp engine
# bee2evp - это адаптер, который позволяет использовать алгоритмы bee2 через OpenSSL API
[bee2evp_section]
# Идентификатор engine, используется для загрузки через openssl engine команду
engine_id = bee2evp
# Путь к динамической библиотеке bee2evp
# В продакшене может потребоваться изменить на системный путь установки
dynamic_path = /build/build/install/lib/libbee2evp.so
# Использовать все алгоритмы bee2evp по умолчанию
# Можно указать конкретные: belt, bign, bash или их комбинации
default_algorithms = ALL