# Пример файла переменных окружения для тестовой инфраструктуры OpenVPN
# Скопируйте этот файл в .env и настройте значения для тестов (если нужно)
#
# Использование:
#   cp env.example .env
#   # Отредактируйте .env и установите нужные значения (опционально)
#   ./test-all.sh
#
# Примечание: По умолчанию используются тестовые значения (TestVPN),
# поэтому создание .env файла не обязательно для тестов.

# ============================================
# Настройки сертификатов для тестов
# ============================================

# Страна (ISO 3166-1 alpha-2 код)
CERT_COUNTRY=BY

# Регион/Область
CERT_STATE=Minsk

# Город
CERT_CITY=Minsk

# Название организации (для тестов используется TestVPN)
CERT_ORG=TestVPN

# ============================================
# Настройки для CA (Центр сертификации)
# ============================================

# Подразделение CA
CERT_OU_CA=IT

# Имя CA сертификата
CERT_CN_CA=TestVPN-CA

# ============================================
# Настройки для сервера
# ============================================

# Подразделение сервера
CERT_OU_SERVER=Server

# Имя серверного сертификата
CERT_CN_SERVER=server

# ============================================
# Настройки для клиента
# ============================================

# Подразделение клиента
CERT_OU_CLIENT=Client

# Имя клиентского сертификата
CERT_CN_CLIENT=client
