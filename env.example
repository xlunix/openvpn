# Пример файла переменных окружения для OpenVPN
# Скопируйте этот файл в .env и настройте значения для вашего окружения
#
# Использование:
#   cp env.example .env
#   # Отредактируйте .env и установите нужные значения
#   docker compose -f docker-compose-server.yaml up -d
#   # или
#   docker compose -f docker-compose-client.yaml up -d

# ============================================
# Настройки сертификатов
# ============================================

# Страна (ISO 3166-1 alpha-2 код, например: BY, RU, US)
CERT_COUNTRY=BY

# Регион/Область
CERT_STATE=Minsk

# Город
CERT_CITY=Minsk

# Название организации
CERT_ORG=YourCompany

# ============================================
# Настройки для CA (Центр сертификации)
# ============================================

# Подразделение CA
CERT_OU_CA=IT

# Имя CA сертификата
CERT_CN_CA=YourCompany-CA

# ============================================
# Настройки для сервера
# ============================================

# Подразделение сервера
CERT_OU_SERVER=Server

# Имя серверного сертификата (обычно доменное имя или IP)
CERT_CN_SERVER=vpn-server

# ============================================
# Настройки для клиента
# ============================================

# Подразделение клиента
CERT_OU_CLIENT=Client

# Имя клиентского сертификата (обычно имя пользователя или устройства)
CERT_CN_CLIENT=vpn-client
